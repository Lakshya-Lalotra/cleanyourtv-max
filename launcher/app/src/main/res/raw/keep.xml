<?xml version="1.0" encoding="utf-8"?>
<!-- app_banners and app_logos name drawables at run time, which resource shrinking cannot see: keep every
     banner_* and logo_*. Strict: those are the launcher's only getIdentifier calls, and safe mode also keeps every
     resource whose name matches a string literal anywhere in the code (AndroidX translations among them). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/banner_*,@drawable/logo_*"
    tools:shrinkMode="strict" />
